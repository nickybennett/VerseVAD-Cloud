* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.command text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Checksum-pinned research data must remain byte-identical
/source_lexicons/** -text
/resources/pronunciation/** -text

# Preserve curated reference-poem bytes exactly on Windows and macOS.
resources/VerseMap_Reference_Corpus/** -text
